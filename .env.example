APP_ENV=development
LOG_LEVEL=INFO

# Set only in a local, ignored .env file. Never commit a connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=agent_search
MONGODB_SOURCE_FILES_COLLECTION=source_files
MONGODB_CHUNKS_COLLECTION=chunks

# Gemini credentials belong only in ignored .env, never in this example file.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=gemini-embedding-2-768-l2-v1
EMBEDDING_NORMALIZATION=l2
RRF_K=60
